{
  "openapi": "3.1.0",
  "info": {
    "title": "Make My Wedding Plan API",
    "version": "1.0.0",
    "description": "Private, invitation-only wedding management platform — V1 REST API. Source of truth: doc/prd.md, doc/db_design.docx, doc/api_design.docx, doc/system_design_architecture.pdf."
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1",
      "description": "development"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealthz",
        "summary": "Liveness probe",
        "description": "Returns 200 whenever the process is up. Never touches the database.",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadyz",
        "summary": "Readiness probe",
        "description": "Returns 200 when the app can serve real traffic, 503 otherwise (e.g. DB not yet connected).",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The app is ready to serve traffic.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency (e.g. the database) is not yet available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LivenessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "ok"
              },
              "uptimeSeconds": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "status",
              "uptimeSeconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": false
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "not_ready"
                ]
              },
              "db": {
                "type": "string",
                "enum": [
                  "connected",
                  "disconnected"
                ]
              },
              "uptimeSeconds": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "status",
              "db",
              "uptimeSeconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "accessTokenCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token",
        "description": "Short-lived JWT issued to authenticated Admin/Manager users (15 minutes)."
      },
      "guestSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "guest_session",
        "description": "Short-lived session issued after invitation-token validation."
      }
    }
  }
}
