{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",

  "regions": ["bom1"],

  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },

  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
