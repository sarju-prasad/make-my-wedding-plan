# =============================================================================
# Make My Wedding Plan — backend environment template
#
# Copy to `.env` for local development. Every variable here is parsed and
# validated by src/config/env.ts at boot; a missing or malformed value fails
# fast rather than surfacing as a runtime error later.
#
# Never commit a populated .env. Production values live in Vercel secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mmwp_dev

# --- Authentication ----------------------------------------------------------
# Two distinct secrets. A single shared secret lets a refresh token be replayed
# as an access token. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-value
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Short-lived guest session issued after invitation validation.
GUEST_SESSION_TTL=2h

# Byte length of the raw invitation token (only its hash is ever stored).
INVITATION_TOKEN_BYTES=32

# --- Cookies -----------------------------------------------------------------
# COOKIE_SAMESITE must be `none` whenever the frontend and backend are on
# different sites (local dev on separate ports, Vercel preview deployments).
# `lax` is correct only behind the shared-domain rewrite described in
# system_design_architecture.pdf §4. See conflict C13.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN is intentionally left unset — cookies are host-only.

# --- CORS --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cloudflare R2 (private photo storage) -----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mmwp-photos-dev
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PRESIGN_UPLOAD_TTL=300
R2_PRESIGN_DOWNLOAD_TTL=300

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Make My Wedding Plan <noreply@example.com>
EMAIL_REPLY_TO=

# --- Scheduled jobs ----------------------------------------------------------
# Shared secret required by /api/v1/internal/jobs/* so only the scheduler can
# trigger reminder and expiry runs. See gap G7 — pending decision D8.
CRON_SECRET=

# --- Limits (PRD §34, api_design §17) ----------------------------------------
MAX_UPLOAD_PHOTOS=10
MAX_UPLOAD_BYTES=10485760
MAX_PAGE_LIMIT=100
