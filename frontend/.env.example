# =============================================================================
# Make My Wedding Plan — frontend environment template
#
# Copy to `.env.local` for local development. Next.js inlines any
# NEXT_PUBLIC_* variable into the client bundle at build time.
#
# Never commit a populated .env.local. Production values live in Vercel.
# =============================================================================

# The backend's versioned API base path. ../backend/.env.example's
# APP_BASE_URL + API_BASE_PATH (backend/src/config/constants.ts) is
# http://localhost:4000/api/v1 by default in local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# A Google Maps JavaScript API key with the Places API enabled, used by
# VenueAddressField (create-wedding form) for live address autocomplete so
# users don't have to type raw latitude/longitude. This is loaded into the
# browser, so it's meant to be public — restrict it to your domain(s) (and
# localhost for dev) in the Google Cloud Console, not treated as a secret.
# Leaving this unset is fine: the form falls back to plain manual address +
# lat/long entry instead of failing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
