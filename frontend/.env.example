# =============================================================================
# Make My Wedding Plan — frontend environment template
#
# Copy to `.env.local` for local development. Next.js inlines any
# NEXT_PUBLIC_* variable into the client bundle at build time.
#
# Never commit a populated .env.local. Production values live in Vercel.
# =============================================================================

# The backend's versioned API base path. ../backend/.env.example's
# APP_BASE_URL + API_BASE_PATH (backend/src/config/constants.ts) is
# http://localhost:4000/api/v1 by default in local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
